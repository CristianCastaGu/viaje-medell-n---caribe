# ---------------------------------------------------------------------
# Supabase (base de datos). OBLIGATORIAS para que /api/trip/* funcione.
# Sácalas de tu proyecto en supabase.com -> Project Settings -> API.
# ---------------------------------------------------------------------

# SUPABASE_URL: la URL de tu proyecto, ej. https://xxxxxxxx.supabase.co
SUPABASE_URL="https://TU-PROYECTO.supabase.co"

# SUPABASE_SERVICE_ROLE_KEY: la llave "service_role" (NO la "anon").
# Tiene acceso total a la base saltándose RLS, así que:
#   - Solo se usa en el servidor (server.ts, src/server/*, api/*).
#   - NUNCA debe empezar con VITE_ (eso la metería al bundle del navegador).
#   - NUNCA la subas a un repo público.
SUPABASE_SERVICE_ROLE_KEY="TU_SERVICE_ROLE_KEY"

# ---------------------------------------------------------------------
# Credenciales de acceso a la app (opcionales — si no las defines,
# se usan las palabras por defecto pedidas para este viaje).
# ---------------------------------------------------------------------
# TRIP_GROUP_SECRET="Desapareceresopcional"
# TRIP_ADMIN_PASSWORD="adminSabana"

# ---------------------------------------------------------------------
# GEMINI_API_KEY: heredado de la plantilla de AI Studio. No lo usa
# ninguna función actual de esta app; déjalo vacío o elimínalo si no
# planeas agregar features con Gemini.
# ---------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
